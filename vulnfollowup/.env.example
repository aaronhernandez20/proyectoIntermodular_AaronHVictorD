# Copia este fichero como .env y pon tus propios valores.
# .env está en el .gitignore: NUNCA se sube al repositorio.

DB_NAME=vulnfollowup
DB_USER=vfu
DB_PASSWORD=cambia_esta_contraseña

# Clave para firmar los JWT: mínimo 32 caracteres, aleatoria.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_de_32_o_mas_caracteres

CORS_ORIGINS=http://localhost:4200,http://localhost:8100
